{
  "name": "@ba-design-system/workspace",
  "version": "0.4.0",
  "private": true,
  "description": "BA Design System monorepo, sourced from Figma.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "validate": "node build/validate.mjs",
    "components": "python3 build/generate_components.py && node build/consumer-bundle.mjs && node build/figma-parity.mjs",
    "code-connect": "node build/code-connect.mjs status",
    "code-connect:verify": "node build/code-connect.mjs verify",
    "code-connect:export": "node build/code-connect.mjs export",
    "code-connect:parse": "figma connect parse",
    "code-connect:publish": "figma connect publish",
    "check": "npm run validate && npm run build && npm run components && npm run code-connect:verify",
    "typecheck": "tsc --noEmit -p packages/react/tsconfig.json",
    "test": "node --test packages/react/test/*.test.mjs",
    "showcase:dev": "vite --config apps/showcase/vite.config.ts",
    "showcase:build": "vite build --config apps/showcase/vite.config.ts",
    "convert:figma": "node build/convert-to-figma.mjs",
    "bridge": "node build/bridge.mjs",
    "replicate": "node build/bridge.mjs extract"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.7"
  }
}
